# Copy this file to .env (already gitignored) and fill in real values before running
# az bicep build-params / what-if / create from this directory. See infra/README.md's Secrets
# section for what each of these controls and why the empty-default ones are safe to leave unset.

# Required -- FlightAi.Api and FlightAi.Booking.Functions both throw at startup without it.
# Must stay stable across redeploys: regenerating it invalidates any price assertion currently
# in flight between a search response and a booking request.
PRICE_ASSERTION_SIGNING_KEY=

# Optional -- omit to deploy with the deterministic offline chat client instead of a real model.
GEMINI_API_KEY=

# Optional -- omit to deploy with the mock supplier connectors only. Use a Duffel *test-mode*
# token, never a live one -- see docs/reference/12-supplier-api-options.md.
DUFFEL_API_KEY=
