# Local dev only — the Vite dev server (5173) and dotnet run's default profile (5294) are different
# origins, unlike the same-origin default this app falls back to. Not read by `vite build`, so a
# production build still requires this configured at deploy time (see F03's locked decision and
# docs/features/03-infra/tasks/02-static-web-apps-deployment.md).
VITE_API_BASE_URL=http://localhost:5294
VITE_BOOKING_API_BASE_URL=http://localhost:7071
